---
// Responsive image through astro:assets (getImage): AVIF + WebP <picture>, srcset, explicit width/height on the
// <img>, `alt` required (use "" for decorative scenes and the byline photo). Never upscales: srcset widths above
// the source width are dropped. `ratio` reserves the box (aspect-ratio + object-fit: cover) so a slow image never
// shifts layout. No inline style attributes (a strict CSP may block them); ratios and focal points are classes.
// The <picture> is written here rather than with astro:assets <Picture> so an empty alt is emitted as alt=""
// (Astro serializes an empty attribute value as a bare `alt`, which some validators read as missing).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  ratio?: '1x1' | '4x5' | '3x2' | '4x3' | '21x9' | '596x715' | '673x841';
  position?: 'center' | 'top' | 'upper' | 'right' | 'lower';
  loading?: 'lazy' | 'eager';
  priority?: boolean; // fetchpriority=high: only the page's LCP image
  class?: string; // on <picture>
  imgClass?: string;
  quality?: number;
}
const { src, alt, sizes, widths = [320, 640, 960, 1280, 1920], ratio, position, loading = 'lazy', priority = false, class: cls, imgClass, quality = 78 } = Astro.props;
if (typeof alt !== 'string') throw new Error('Image.astro: alt is required ("" for decorative images)');
const cap = Math.min(src.width, Math.max(...widths));
const usable = [...new Set([...widths.filter((w) => w <= src.width), cap])].sort((a, b) => a - b);
// AVIF reaches WebP's visual quality at a much lower setting; 0.7x keeps every 1280w hero under the
// 200 KB AVIF budget (A23 P800) without visible loss on the generated scenes.
const avifQuality = Math.round(quality * 0.7);
const build = async (format: 'avif' | 'webp') => {
  const q = format === 'avif' ? avifQuality : quality;
  const out = await Promise.all(usable.map((w) => getImage({ src, width: w, format, quality: q })));
  return out.map((r, i) => `${r.src} ${usable[i]}w`).join(', ');
};
const avif = await build('avif');
const webp = await build('webp');
const fallback = await getImage({ src, width: usable.find((w) => w >= 960) ?? cap, format: 'webp', quality });
const width = cap;
const height = Math.round((cap * src.height) / src.width);
const imgClasses = [ratio && `ratio-${ratio}`, position && `pos-${position}`, imgClass].filter(Boolean).join(' ') || undefined;
const load = priority ? 'eager' : loading;
---
<picture class={cls}>
  <source type="image/avif" srcset={avif} sizes={sizes} />
  <source type="image/webp" srcset={webp} sizes={sizes} />
  {alt === '' ? (
    <img src={fallback.src} srcset={webp} sizes={sizes} alt="" width={width} height={height} loading={load} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : undefined} class={imgClasses} />
  ) : (
    <img src={fallback.src} srcset={webp} sizes={sizes} alt={alt} width={width} height={height} loading={load} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : undefined} class={imgClasses} />
  )}
</picture>
