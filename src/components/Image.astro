---
// Responsive image through astro:assets: AVIF + WebP <picture>, srcset, explicit width/height on the <img>,
// `alt` required (use "" for decorative scenes). Never upscales: srcset widths above the source width are
// dropped. `ratio` reserves the box (aspect-ratio + object-fit: cover) so a slow image never shifts layout.
// No inline style attributes (a strict CSP may block them); ratios and focal points are classes.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  ratio?: '1x1' | '4x5' | '3x2' | '4x3' | '21x9' | '596x715' | '673x841'; // reserved box (class, no inline style: CSP-safe)
  position?: 'center' | 'top' | 'upper' | 'right' | 'lower'; // object-position presets (components.css)
  loading?: 'lazy' | 'eager';
  priority?: boolean; // fetchpriority=high: only the page's LCP image
  class?: string; // on <picture>
  imgClass?: string;
}
const { src, alt, sizes, widths = [320, 640, 960, 1280, 1920], ratio, position, loading = 'lazy', priority = false, class: cls, imgClass } = Astro.props;
if (typeof alt !== 'string') throw new Error('Image.astro: alt is required ("" for decorative images)');
const usable = [...new Set(widths.filter((w) => w <= src.width))].sort((a, b) => a - b);
if (!usable.length || usable[usable.length - 1] < Math.min(src.width, Math.max(...widths))) usable.push(Math.min(src.width, Math.max(...widths)));
const width = usable[usable.length - 1];
const height = Math.round((width * src.height) / src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={usable}
  sizes={sizes}
  width={width}
  height={height}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading={priority ? 'eager' : loading}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  pictureAttributes={{ class: cls }}
  class:list={[ratio && `ratio-${ratio}`, position && `pos-${position}`, imgClass]}
/>
