---
// Language toggle (DESIGN-SYSTEM 7.6): a link (not a button, not a select) to the current page's twin from
// plan/sitemap.json; hreflang + lang on the link; label in the target language. Pages without a twin link to the
// other language's home. variant: header ("ES"/"Español" by width), block (menu foot), strip (phone language
// strip above the header), footer, inline.
import Icon from './Icon.astro';
import { alternatePath, type Lang } from '../lib/site';
import { t } from '../lib/i18n';
interface Props { lang: Lang; path: string; variant?: 'header' | 'block' | 'strip' | 'footer' | 'inline'; class?: string }
const { lang, path, variant = 'inline', class: cls } = Astro.props;
const ui = t(lang);
const target: Lang = lang === 'en' ? 'es' : 'en';
const href = alternatePath(path, target);
---
{variant === 'strip' ? (
  <div class:list={['lang-strip', cls]}>
    <a class="lang-strip__link" href={href} hreflang={target} lang={target}><Icon name="languages" /><span>{ui.langStrip}</span></a>
  </div>
) : variant === 'header' ? (
  <a class:list={['lang-toggle', 'lang-toggle--header', cls]} href={href} hreflang={target} lang={target} aria-label={ui.toggleLong}>
    <span class="lang-toggle__long">{ui.toggleLong}</span><span class="lang-toggle__short" aria-hidden="true">{ui.toggleShort}</span>
  </a>
) : (
  <a class:list={['lang-toggle', `lang-toggle--${variant}`, cls]} href={href} hreflang={target} lang={target}>
    {variant !== 'footer' && <Icon name="languages" />}<span>{ui.toggleLong}</span>
  </a>
)}
