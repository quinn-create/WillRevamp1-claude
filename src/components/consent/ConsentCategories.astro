---
// A22 P600: the three consent category rows (DESIGN-SYSTEM 7.20), shared by the banner's settings panel and the
// Cookie Settings page. Strictly necessary is a checked, disabled checkbox (DS 7.9;
// no name and no data-consent-cat, so the script and form submission ignore it — it cannot be switched off). Analytics and
// Marketing are unchecked 44px checkbox rows — never pre-ticked; the script reflects a choice the visitor saved.
// A category with no configured vendor still has its switch (the choice is stored and applies if a tool is added
// later, as the Cookie Settings copy promises) and says that no tool is on.
import { C } from './strings';
import { vendorsIn } from './vendors';
import type { Lang } from '../../lib/site';

interface Props { lang: Lang; prefix: string }
const { lang, prefix } = Astro.props;
const s = C(lang);
const rows = [
  { cat: 'analytics', label: s.analytics, desc: s.analyticsDesc, tools: vendorsIn('analytics'), none: s.noAnalytics },
  { cat: 'marketing', label: s.marketing, desc: s.marketingDesc, tools: vendorsIn('marketing'), none: s.noMarketing },
] as const;
---
<fieldset class="consent-cats" data-consent="categories">
  <legend class="visually-hidden">{s.legend}</legend>
  <div class="consent-cat consent-cat--fixed">
    <label class="check consent-cat__head" for={`${prefix}-necessary`}>
      <input type="checkbox" id={`${prefix}-necessary`} checked disabled aria-describedby={`${prefix}-necessary-desc`} />
      <span class="consent-cat__name">{s.necessary}</span> <span class="consent-cat__state">{s.alwaysOn}</span>
    </label>
    <p class="consent-cat__desc" id={`${prefix}-necessary-desc`}>{s.necessaryDesc}</p>
  </div>
  {rows.map((r) => (
    <div class="consent-cat">
      <label class="check consent-cat__head" for={`${prefix}-${r.cat}`}>
        <input type="checkbox" id={`${prefix}-${r.cat}`} name={r.cat} value="on" data-consent-cat={r.cat} aria-describedby={`${prefix}-${r.cat}-desc`} />
        <span class="consent-cat__name">{r.label}</span>
        <span class="consent-cat__state">{s.offUnless}</span>
      </label>
      <p class="consent-cat__desc" id={`${prefix}-${r.cat}-desc`}>
        {r.desc}{' '}
        {r.tools.length ? <span>{s.tools} {r.tools.map((v) => v.name).join(', ')}.</span> : <span>{r.none}</span>}
      </p>
    </div>
  ))}
</fieldset>
