---
// Inline Lucide icon (node_modules/lucide-static/icons), 24px grid, stroke 1.75, currentColor.
// Decorative (aria-hidden) unless `label` is given. Never an icon font, never an <img>.
import fs from 'node:fs';
import path from 'node:path';
import { ROOT } from '../lib/copy';

interface Props { name: string; class?: string; label?: string }
const { name, class: cls = '', label } = Astro.props;
const cache = ((globalThis as any).__lucide ??= new Map<string, string>()) as Map<string, string>;
let src = cache.get(name);
if (!src) {
  const file = path.join(ROOT, 'node_modules', 'lucide-static', 'icons', `${name}.svg`);
  if (!fs.existsSync(file)) throw new Error(`Icon.astro: no Lucide icon "${name}"`);
  src = fs.readFileSync(file, 'utf8').replace(/<!--[\s\S]*?-->/g, '').trim();
  cache.set(name, src);
}
const open = src.match(/^<svg[^>]*>/)![0];
const a11y = label ? `role="img" aria-label="${label.replace(/"/g, '&quot;')}"` : 'aria-hidden="true"';
const svg = src
  .replace(open, open.replace(/\s(class|width|height|stroke-width)="[^"]*"/g, ''))
  .replace(/^<svg/, `<svg class="${['icon', `icon--${name}`, cls].filter(Boolean).join(' ')}" width="24" height="24" stroke-width="1.75" focusable="false" ${a11y}`)
  .replace(/\s*\n\s*/g, ' ');
---
<Fragment set:html={svg} />
