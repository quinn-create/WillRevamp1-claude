---
// Interim home (A19 P100/P300): proves the foundation, components and shell end to end with the home copy.
// A20 replaces this file with the designed Home template in P400.
import Site from '../layouts/Site.astro';
import PageHero from '../components/PageHero.astro';
import Sections from '../components/Sections.astro';
import { loadCopy } from '../lib/copy';

const copy = loadCopy('index', 'en');
---
<Site title={copy.data.title} description={copy.data.description} path="/">
  <PageHero lang="en" path="/" h1={copy.data.h1} deck={copy.sections.find((x) => x.hint === 'hero')?.blocks || []} variant="home" byline="mobile" eyebrow="Attorney at Law · Murfreesboro, Tennessee" />
  <Sections sections={copy.sections} lang="en" />
</Site>
