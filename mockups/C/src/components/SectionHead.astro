---
// Eyebrow (brick, small caps) + H2 from the copy + any intro blocks before the first card/item.
import Blocks from './Blocks.astro';
interface Props { eyebrow?: string; heading: any; intro?: any[]; id?: string; class?: string }
const { eyebrow, heading, intro = [], id, class: cls = '' } = Astro.props;
---
<div class={`section-head ${cls}`} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {heading && <h2 id={id} set:html={heading.html} />}
  <Blocks blocks={intro} />
</div>
