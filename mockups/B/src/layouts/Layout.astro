---
import '../../tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import CallBar from '../components/CallBar.astro';
import { FIRM, esPathFor } from '../lib/site.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  cta?: { heading: string; html: string } | null;
  preloadImage?: { srcset: string; sizes: string; type: string } | null;
}
const { title, description, path, cta = null, preloadImage = null } = Astro.props;
const canonical = FIRM.origin + path;
const es = FIRM.origin + esPathFor(path);
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="theme-color" content="#0b1220" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header current={path} />
    <main id="main" tabindex="-1">
      <slot />
      {cta && <CtaBand heading={cta.heading} html={cta.html} />}
    </main>
    <Footer />
    <CallBar />
    <script is:inline>
      // Reveal once on scroll: 12–16 px rise + fade, staggered 60 ms. Skipped under reduced motion.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
      // Mobile call bar: tucked while a gold call button in <main> is on screen, so each screen has one
      // primary action. Without JS or IntersectionObserver the bar simply stays up.
      (function () {
        var bar = document.querySelector('[data-callbar]');
        var ctas = document.querySelectorAll('main .btn--primary[href^="tel:"]');
        if (!bar || !ctas.length || !('IntersectionObserver' in window)) return;
        var seen = new Set();
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { e.isIntersecting ? seen.add(e.target) : seen.delete(e.target); });
          bar.classList.toggle('is-tucked', seen.size > 0);
        });
        ctas.forEach(function (el) { io.observe(el); });
      })();
      // Mobile menu: native <dialog>, Esc closes, focus returns to the trigger.
      (function () {
        var dlg = document.getElementById('site-menu');
        var opener = document.querySelector('[data-menu-open]');
        if (!dlg || !opener || typeof dlg.showModal !== 'function') return;
        opener.addEventListener('click', function () { dlg.showModal(); opener.setAttribute('aria-expanded', 'true'); });
        dlg.addEventListener('close', function () { opener.setAttribute('aria-expanded', 'false'); opener.focus(); });
        dlg.querySelectorAll('[data-menu-close], a').forEach(function (el) { el.addEventListener('click', function () { dlg.close(); }); });
        dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
      })();
    </script>
  </body>
</html>
