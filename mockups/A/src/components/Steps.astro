---
// [steps]: numbered like a table of contents, tabular numerals in brass.
import { inline } from '../lib/copy.mjs';
import Blocks from './Blocks.astro';
import SectionHead from './SectionHead.astro';
interface Props { section: any; eyebrow?: string }
const { section, eyebrow } = Astro.props;
const ol = section.blocks.find((b: any) => b.type === 'ol');
const others = section.blocks.filter((b: any) => b !== ol);
const idx = section.blocks.indexOf(ol);
const before = others.slice(0, idx);
const after = section.blocks.slice(idx + 1);
const split = (md: string) => {
  const m = md.match(/^\*\*([^*]+)\*\*\s*(.*)$/);
  return m ? { title: m[1], text: m[2] } : { title: '', text: md };
};
---
<div class="steps-block">
  <SectionHead h2={section.h2} eyebrow={eyebrow} />
  {before.length > 0 && <Blocks blocks={before} class="sec-intro" />}
  <ol class="steps">
    {ol.items.map((it: string, i: number) => {
      const s = split(it);
      return (
        <li class="step" data-reveal style={`--i:${i}`}>
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="step__title" set:html={inline(s.title)} />
          <p class="step__text" set:html={inline(s.text)} />
        </li>
      );
    })}
  </ol>
  {after.length > 0 && <Blocks blocks={after} class="fineprint" />}
</div>
