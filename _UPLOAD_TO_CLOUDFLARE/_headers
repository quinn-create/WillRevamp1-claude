# Cloudflare Pages response headers (A23 P700).
# The CSP's hash list is filled in after every build by tools/csp.mjs (`npm run build` = og + redirects +
# astro build + csp), which rewrites dist/_headers. The __CSP_*_HASHES__ placeholders never deploy: csp.mjs fails the build
# if it cannot replace it. Vendor hosts are allowed up front but are only contacted after consent AND a
# configured key (src/components/consent/loaders.ts, site.config.json via tools/configure.mjs).
# Keep each header line under 2,000 characters (Cloudflare limit).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-uTZq1MOj+K6uQUufncqNhKTNdN4aOc8udUqkJE+teeM=' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms https://connect.facebook.net https://analytics.tiktok.com; style-src 'self' 'sha256-OE7WM9C7AfWrLQ+9f2Gf7IG7RejuW2znQPx0jXK0CCI='; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com https://*.clarity.ms https://analytics.tiktok.com; font-src 'self'; connect-src 'self' https://api.web3forms.com https://challenges.cloudflare.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://*.tiktokw.us; frame-src https://challenges.cloudflare.com; manifest-src 'self'; worker-src 'self'; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font file names are not content-hashed: 30 days, not immutable.
/fonts/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=86400
